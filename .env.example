# ============================================
# Formulaire de contact (envoi d'emails)
# ============================================

# Clé API pour le service Resend (https://resend.com) — OBLIGATOIRE pour l'envoi des emails.
# Obtenez votre clé en vous inscrivant sur Resend (tableau de bord > API Keys).
# Le domaine holidaygeekcup.fr doit être vérifié dans Resend (voir README).
# Ne partagez jamais cette clé publiquement.
RESEND_API_KEY=""

# Destinataire des messages du formulaire (défaut si absent : contact@holidaygeekcup.fr)
CONTACT_TO_EMAIL="contact@holidaygeekcup.fr"

# Expéditeur des emails (le domaine doit être vérifié dans Resend)
CONTACT_FROM_EMAIL="Holiday Geek Cup <contact@holidaygeekcup.fr>"

# ============================================
# Cloudflare Turnstile (anti-bots) — OPTIONNEL
# Sans ces clés, le formulaire fonctionne avec les
# protections invisibles seules (honeypot, délai, rate limiting).
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# ============================================
# Backoffice (Payload CMS)
# ============================================

# Chaîne aléatoire longue, utilisée pour signer les sessions admin.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=""

# Jeton attaché au lien « Aperçu » du backoffice, pour activer le mode
# brouillon de Next.js sans l'exposer au public. Même commande que ci-dessus.
PAYLOAD_PREVIEW_SECRET=""

# Connexion MongoDB.
#   local  : mongodb://localhost:27017/hgc-website?replicaSet=rs0&directConnection=true
#            (démarrer la base avec : npm run db:up)
#   prod   : chaîne de connexion MongoDB Atlas
DATABASE_URL=""

# URL publique du site (liens dans les emails, aperçus de contenu).
#
# ⚠️ En production, cette valeur sert aussi de liste blanche anti-CSRF : Payload
# ignore le cookie de session sur toute requête dont l'en-tête `Origin` n'y
# figure pas. Une valeur `localhost` laissée sur Vercel laisse donc le
# backoffice s'afficher (les navigations n'envoient pas d'`Origin`) mais casse
# tout envoi d'image, toute sauvegarde et la déconnexion, avec des 401 en log.
#
# Sur Vercel : laisser vide. L'URL de production du projet est alors détectée
# automatiquement, et les URL de préproduction sont autorisées en plus.
PAYLOAD_SERVER_URL="http://localhost:3000"

# Alias supplémentaires autorisés à ouvrir le backoffice, séparés par des
# virgules — un `www.`, un ancien nom de domaine encore redirigé, etc.
# Le domaine principal et les URL Vercel sont déjà pris en charge.
PAYLOAD_CSRF_ORIGINS=""

# Stockage des images envoyées depuis le backoffice (Vercel Blob).
# Sans ce jeton, les fichiers sont écrits dans public/media en local.
BLOB_READ_WRITE_TOKEN=""
